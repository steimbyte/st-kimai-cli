{
  "name": "st-kimai-cli",
  "version": "1.1.0",
  "description": "CLI tool for Kimai time-tracking API",
  "main": "dist/index.js",
  "bin": {
    "kimai-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "link": "npm run build && npm link",
    "test": "vitest",
    "test:run": "vitest run"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "kimai",
    "time-tracking",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "commander": "^12.0.0",
    "picocolors": "^1.1.1"
  },
  "devDependencies": {
    "@types/node": "^20.19.41",
    "typescript": "^5.3.0",
    "vitest": "^4.1.7"
  },
  "vitest": {
    "test": {
      "include": [
        "src/**/*.test.ts"
      ],
      "environment": "node"
    }
  }
}
